VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN dcr ;
TECHNOLOGY saed14rvt_1p9m ;
UNITS DISTANCE MICRONS 1000 ;
DIEAREA ( 0 0 ) ( 4588 4800 ) ;
ROW ROW_0 unit 0 0 N DO 62 BY 1 STEP 74 0 ;
ROW ROW_1 unit 0 600 FS DO 62 BY 1 STEP 74 0 ;
ROW ROW_2 unit 0 1200 N DO 62 BY 1 STEP 74 0 ;
ROW ROW_3 unit 0 1800 FS DO 62 BY 1 STEP 74 0 ;
ROW ROW_4 unit 0 2400 N DO 62 BY 1 STEP 74 0 ;
ROW ROW_5 unit 0 3000 FS DO 62 BY 1 STEP 74 0 ;
ROW ROW_6 unit 0 3600 N DO 62 BY 1 STEP 74 0 ;
ROW ROW_7 unit 0 4200 FS DO 62 BY 1 STEP 74 0 ;
TRACKS X 37 DO 62 STEP 74 LAYER M1 ;
TRACKS Y 30 DO 80 STEP 60 LAYER M1 ;
TRACKS Y 30 DO 80 STEP 60 LAYER M2 ;
TRACKS X 37 DO 62 STEP 74 LAYER M2 ;
TRACKS X 37 DO 62 STEP 74 LAYER M3 ;
TRACKS Y 30 DO 80 STEP 60 LAYER M3 ;
TRACKS Y 50 DO 48 STEP 100 LAYER M4 ;
TRACKS X 37 DO 62 STEP 74 LAYER M4 ;
TRACKS X 50 DO 46 STEP 100 LAYER M5 ;
TRACKS Y 50 DO 48 STEP 100 LAYER M5 ;
TRACKS Y 50 DO 48 STEP 100 LAYER M6 ;
TRACKS X 50 DO 46 STEP 100 LAYER M6 ;
TRACKS X 50 DO 46 STEP 100 LAYER M7 ;
TRACKS Y 50 DO 48 STEP 100 LAYER M7 ;
TRACKS Y 50 DO 48 STEP 100 LAYER M8 ;
TRACKS X 50 DO 46 STEP 100 LAYER M8 ;
TRACKS X 50 DO 46 STEP 100 LAYER M9 ;
TRACKS Y 50 DO 48 STEP 100 LAYER M9 ;
TRACKS Y 2000 DO 1 STEP 4000 LAYER MRDL ;
TRACKS X 50 DO 46 STEP 100 LAYER MRDL ;
COMPONENTS 18 ;      
 - dcr_reg_reg\[7\] SAEDRVT14_FDP_V2_0P5 ;
 - dcr_reg_reg\[6\] SAEDRVT14_FDP_V2_0P5 ;
 - dcr_reg_reg\[5\] SAEDRVT14_FDP_V2_0P5 ;
 - dcr_reg_reg\[4\] SAEDRVT14_FDP_V2_0P5 ;
 - dcr_reg_reg\[3\] SAEDRVT14_FDP_V2_0P5 ;
 - dcr_reg_reg\[2\] SAEDRVT14_FDP_V2_0P5 ;
 - dcr_reg_reg\[1\] SAEDRVT14_FDP_V2_0P5 ;
 - dcr_reg_reg\[0\] SAEDRVT14_FDP_V2_0P5 ;
 - U22 SAEDRVT14_AN2B_MM_1 ;
 - U23 SAEDRVT14_NR2_MM_1 ;
 - U24 SAEDRVT14_AO22_0P75 ;
 - U25 SAEDRVT14_AO22_0P75 ;
 - U26 SAEDRVT14_AO22_0P75 ;
 - U27 SAEDRVT14_AO22_0P75 ;
 - U28 SAEDRVT14_AO22_0P75 ;
 - U29 SAEDRVT14_AO22_0P75 ;
 - U30 SAEDRVT14_AO22_0P75 ;
 - U31 SAEDRVT14_AO22_0P75 ;
END COMPONENTS
PINS 19 ;      
 - clk + NET clk + DIRECTION INPUT + USE SIGNAL + LAYER M4 ( -30 -30 ) ( 30 30 ) + PLACED ( 30 2350 ) W ;
 - reset + NET reset + DIRECTION INPUT + USE SIGNAL + LAYER M3 ( -17 -17 ) ( 17 17 ) + PLACED ( 1517 4783 ) N ;
